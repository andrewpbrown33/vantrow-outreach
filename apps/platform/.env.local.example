# apps/platform — environment variables the product app reads.
#
# Copy to apps/platform/.env.local for local runs (that file is gitignored;
# only this .example is tracked). In production every value lives in Vercel →
# nudgerow-platform → Settings → Environment Variables (runbooks 08 §2 and
# 09 §3). Placeholders only: never a real value in this file.
#
# Every variable here is SERVER-ONLY. None may be prefixed NEXT_PUBLIC_ — that
# prefix ships the value to the browser (decision log 2026-08-10; runbook 08 §2).
# Build-time (NEXT_PUBLIC_*) variables: none.

# --- Database (the engine, the minute cron, every product surface) -----------
# Service-role Postgres connection string — Supabase → Connect → Transaction
# pooler. Bypasses RLS; the pool in src/lib/db.ts is server-only. Required.
SUPABASE_DB_URL=<from Supabase → Connect → Transaction pooler; runbook 08 §2>

# --- Sign-in (Supabase Auth magic link, own signed session cookie) ----------
# Project URL, nothing after ".co" — Supabase → Settings → API. Required.
SUPABASE_URL=https://<project-ref>.supabase.co
# The anon / public key — Supabase → Settings → API. Required.
SUPABASE_ANON_KEY=<from Supabase → Settings → API (anon key); runbook 09 §1>
# Ours, not Supabase's: signs the session cookie. `openssl rand -hex 32`.
# Rotating it signs everyone out, nothing else. Required.
AUTH_SECRET=<openssl rand -hex 32; runbook 09 §2>
# Optional, comma-separated: addresses that may request a sign-in link without
# already being a connected mailbox in a workspace (runbook 09 §5).
NUDGEROW_ALLOWED_EMAILS=<comma-separated emails, or leave unset>

# --- Where this app lives -------------------------------------------------
# Public origin, no trailing slash — the Gmail redirect_uri Google matches
# exactly, and where the sign-in link comes back to. REQUIRED in production
# (the app throws without it); unset locally, the request's host is used.
APP_ORIGIN=<https://app.nudgerow.com in production; unset or http://localhost:3000 locally>

# --- The minute heartbeat (/api/cron/tick, vercel.json cron) ----------------
# Bearer token the cron sends. Unset means the route is LOCKED (401), never
# open. `openssl rand -hex 32`.
CRON_SECRET=<openssl rand -hex 32; runbook 08 §2>

# --- Gmail (OAuth client `nudgerow-connect` in Google Cloud project
#     `nudgerow-dogfood` → APIs & Services → Credentials; runbook 07 §4) ------
GOOGLE_OAUTH_CLIENT_ID=<from Google Cloud console → Credentials → nudgerow-connect>
# Shown once at creation; if lost, Reset secret in the console (runbook 08 §2).
GOOGLE_OAUTH_CLIENT_SECRET=<from Google Cloud console → Credentials → nudgerow-connect>
# AES-256-GCM key for Gmail refresh tokens at rest: exactly 32 bytes, base64.
# `openssl rand -base64 32`. Production REFUSES to store a token without it;
# a token sealed under one key cannot be opened with another, so keep it in
# the password manager. Unset locally, tokens are stored in plaintext.
MAILBOX_TOKEN_KEY=<openssl rand -base64 32; runbook 08 §2>

# --- Family console (getvantrow.com reads GET /v1/metrics) -----------------
# Bearer token for /v1/metrics. Unset means LOCKED (401), never open.
# The same value goes in the hub as NUDGEROW_CONNECT_KEY (runbook 08).
CONNECT_METRICS_KEY=<openssl rand -hex 32; runbook 08>

# --- Not set here ---------------------------------------------------------
# NODE_ENV — set by Next (`next dev` / `next build`); the code reads it to
#   decide production-only rules (secure cookies, APP_ORIGIN and
#   MAILBOX_TOKEN_KEY being required). Do not set it in .env.local.
# DATABASE_URL — read only by the engine invariant suite (`pnpm test` from the
#   repo root; packages/engine/src/test-db.ts), not by the app, and not from
#   this file: export it in the shell. CI uses
#   postgres://postgres:postgres@localhost:5432/postgres; unset, the suite
#   boots the local Debian cluster itself. CI=true makes a missing Postgres
#   fatal instead of a skip.
# scripts/gmail-connect.mjs and scripts/seed-campaign.mjs take
#   SUPABASE_DB_URL, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET and
#   MAILBOX_TOKEN_KEY from the shell (plus optional PORT, default 8765, for the
#   loopback OAuth listener) — see runbook 07 §6.
